{
  "name": "bpm-modeler-desktop",
  "version": "1.0.0",
  "description": "Cross-platform BPMN and DMN desktop modeler",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:browser\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:browser": "npm run prepare:help-examples && vite",
    "build": "node scripts/package-release.mjs win",
    "build:with-runner": "npm run security:check && npm run build:renderer && npm run build:runner && npm run notices:generate && electron-builder --win --publish never",
    "build:renderer": "npm run prepare:help-examples && vite build",
    "prepare:help-examples": "node scripts/generate-help-example-index.mjs",
    "build:runner": "node dmn-runner/build.mjs",
    "security:check": "node scripts/security-check.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron .",
    "package": "npm run build",
    "package:win": "npm run build",
    "package:linux": "node scripts/package-release.mjs linux",
    "package:linux:with-runner": "npm run security:check && npm run build:renderer && npm run build:runner && npm run notices:generate && electron-builder --linux --publish never",
    "package:mac": "node scripts/package-release.mjs mac",
    "package:mac:with-runner": "npm run security:check && npm run build:renderer && npm run build:runner && npm run notices:generate && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@kie-tools/dmn-editor-standalone": "10.2.0",
    "bpmn-js": "^18.0.0",
    "bpmn-js-properties-panel": "^5.53.0",
    "bpmn-js-token-simulation": "^0.40.0",
    "cmmn-js": "^0.20.0",
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "de.bpmmodeler.desktop",
    "productName": "BPM Modeler",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/lang/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-LICENSES.md",
      "CHANGELOG.md",
      "THIRD-PARTY-NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "dmn-runner/dist",
        "to": "dmn-runner",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build-assets/icons/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName} ${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "build-assets/icons",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "icon": "build-assets/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    }
  }
}
